module test_MossFwet
  !
  ! DESCRIPTION:
  !   Tests the two moss wetness proxies, the liquid one diagnosed by
  !   fates_patch_type::UpdateMossFwetLiq and the total-water one diagnosed by
  !   fates_patch_type::UpdateMossFwetTot; the moss wetness scaler that
  !   MossWetnessScaler derives from the liquid proxy; and the moss CO2 water-film
  !   factor MossCO2FilmFactor that consumes the total proxy.
  !
  use FatesConstantsMod,      only : r8 => fates_r8
  use FatesConstantsMod,      only : nearzero
  use FatesPatchMod,          only : fates_patch_type
  use FatesInterfaceTypesMod, only : hlm_moss_vcmax_fwet_thresh
  use LeafBiophysicsMod,      only : MossCO2FilmFactor
  use LeafBiophysicsMod,      only : lb_params
  use funit

  implicit none

  @TestCase
  type, extends(TestCase) :: TestMossFwet
     type(fates_patch_type) :: patch ! patch carrying the five moss wetness members
   contains
     procedure :: setUp
  end type TestMossFwet

  real(r8), parameter :: tol = 1.e-13_r8

  ! Tolerance for the inner-clamp film case alone. tol is an absolute bound, which is
  ! generous slack everywhere else in this file but is a relative bound of 0.1 against
  ! that case's expected value of 1.0e-12. This restores a relative bound comparable to
  ! the rest of the file: it is comfortably above the ~6e-28 gap between 0.1**12 as
  ! evaluated and the 1.0e-12_r8 literal, and twelve orders of magnitude below the
  ! distance to the answer a dropped inner clamp would give.
  real(r8), parameter :: tol_film_inner = 1.0e-24_r8

  ! Markers seeded into the five patch members by setUp. They are distinct from each
  ! other, so a value written into the wrong member is visible, and negative, so no
  ! marker can be mistaken for an expected result: every expected result below lies in
  ! [0,1]. Uninitialized-variable checking is off in this build, so an unseeded member
  ! would read as whatever the stack held and the seeding is not optional.
  real(r8), parameter :: marker_fwet_liq = -1.0_r8      ! seed for fwet_moss_liq
  real(r8), parameter :: marker_fwet_tot = -3.0_r8      ! seed for fwet_moss_tot
  real(r8), parameter :: marker_soil_liq = -5.0_r8      ! seed for fwet_moss_soil_liq
  real(r8), parameter :: marker_soil_tot = -7.0_r8      ! seed for fwet_moss_soil_tot
  real(r8), parameter :: marker_canopy_tot = -9.0_r8        ! seed for fwet_moss_canopy_tot

  ! Host scalars the tests run at, deliberately not the namelist defaults so that the
  ! tests do not depend on values the host may retune; those defaults are 0.6 for
  ! hlm_moss_vcmax_fwet_thresh and 1.0e-6 for lb_params%moss_co2_film_min. The two
  ! wetness thresholds differ from each other on purpose: replacing
  ! hlm_moss_vcmax_fwet_thresh in the source with either literal then fails somewhere.
  real(r8), parameter :: test_vcmax_thresh = 0.5_r8         ! hlm_moss_vcmax_fwet_thresh for the UpdateMossFwetLiq/Tot cases
  real(r8), parameter :: test_vcmax_thresh_scaler = 0.25_r8 ! hlm_moss_vcmax_fwet_thresh for the scaler cases
  real(r8), parameter :: test_co2_film_min = 4.0e-6_r8      ! lb_params%moss_co2_film_min for the film cases

  ! Floor for the inner-clamp film case alone. It sits below the bound the routine's
  ! internal dry-fraction clamp imposes, which its header names as the only regime in
  ! which that clamp has any effect at all.
  real(r8), parameter :: test_co2_film_min_tiny = 1.0e-15_r8 ! lb_params%moss_co2_film_min for the inner-clamp case

  ! Porosity the host passes for a column it has no soil data for. wrap_btran, in
  ! src/utils/clmfates_interfaceMod.F90, writes this into watsat_sl and into the soil
  ! water fields alike for columns outside the exposed-vegetation filter.
  real(r8), parameter :: watsat_sentinel = -999.0_r8

  ! Two porosities that bracket FatesConstantsMod's nearzero tightly, a quarter of it
  ! below and twice it above, so that the porosity check in MossSoilSaturation (which
  ! zeroes the soil ingredient unless watsat_top > nearzero) has a case it must reject and
  ! a case it must admit within a factor of eight of each other. That is what pins the
  ! check's position relative to nearzero: a bracket loose in either direction leaves it
  ! free to move by orders of magnitude with every test still passing. Both are derived
  ! from nearzero because these cases test the check relative to nearzero, not the value
  ! of nearzero: if that constant is retuned, the bracket follows it and the check is
  ! still pinned to it.
  real(r8), parameter :: watsat_below_nearzero = 0.25_r8*nearzero ! porosity the check must reject [m3/m3]
  real(r8), parameter :: watsat_above_nearzero = 2.0_r8*nearzero  ! porosity the check must admit [m3/m3]

  contains

    subroutine setUp(this)
      class(TestMossFwet), intent(inout) :: this ! test object

      ! the host scalars are module variables that persist across tests, so reset them
      ! here rather than relying on each test to set them
      hlm_moss_vcmax_fwet_thresh = test_vcmax_thresh
      lb_params%moss_co2_film_min = test_co2_film_min

      this%patch%fwet_moss_liq = marker_fwet_liq
      this%patch%fwet_moss_tot = marker_fwet_tot
      this%patch%fwet_moss_soil_liq = marker_soil_liq
      this%patch%fwet_moss_soil_tot = marker_soil_tot
      this%patch%fwet_moss_canopy_tot = marker_canopy_tot

    end subroutine setUp

    ! ======================================================================================
    ! UpdateMossFwetLiq: the liquid proxy and its two ingredients
    ! ======================================================================================

    @Test
    subroutine UpdateMossFwetLiq_SoilWetterThanCanopy_ProxyTakesSoil(this)
      ! UpdateMossFwetLiq must take the liquid proxy from the soil ingredient when the top
      ! soil layer is wetter than the canopy.
      !
      ! The twin of UpdateMossFwetLiq_CanopyWetterThanSoil_ProxyTakesCanopy, which differs
      ! only in which of the two ingredients is the larger. Between them they pin that
      ! the proxy is the wetter of the pair rather than either one of them, or the drier.
      ! The soil ingredient here is the ratio of water to porosity, away from both clamps.
      ! UpdateMossFwetTot_SoilWetterThanCanopy_ProxyTakesSoil is the same case for the
      ! total proxy.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_veg = 0.125_r8                    ! canopy wetted fraction [0-1]
      real(r8), parameter :: h2o_liqvol_top = 0.1875_r8             ! liquid volumetric water, top soil layer [m3/m3]
      real(r8), parameter :: watsat_top = 0.5_r8                    ! porosity of top soil layer [m3/m3]
      real(r8), parameter :: expect_soil = 0.375_r8                 ! h2o_liqvol_top/watsat_top [0-1]
      real(r8), parameter :: expect_proxy = expect_soil             ! the wetter ingredient [0-1]

      call this%patch%UpdateMossFwetLiq(fwet_veg, h2o_liqvol_top, watsat_top)

      @assertEqual(expect_soil, this%patch%fwet_moss_soil_liq, tolerance=tol)
      @assertEqual(fwet_veg, this%patch%fwet_moss_canopy_tot, tolerance=tol)
      @assertEqual(expect_proxy, this%patch%fwet_moss_liq, tolerance=tol)

    end subroutine UpdateMossFwetLiq_SoilWetterThanCanopy_ProxyTakesSoil

    @Test
    subroutine UpdateMossFwetLiq_CanopyWetterThanSoil_ProxyTakesCanopy(this)
      ! UpdateMossFwetLiq must take the liquid proxy from the canopy ingredient (snow plus
      ! liquid) when the canopy is wetter than the top soil layer.
      !
      ! The twin of UpdateMossFwetLiq_SoilWetterThanCanopy_ProxyTakesSoil, which differs
      ! only in which of the two ingredients is the larger; the porosity is the same in
      ! both. This configuration is rare in a coupled run, because the host caps the canopy
      ! wetted fraction at its maximum_leaf_wetted_fraction parameter, but the routine
      ! makes no such assumption and neither does this test.
      ! UpdateMossFwetTot_CanopyWetterThanSoil_ProxyTakesCanopy is the same case for the
      ! total proxy.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_veg = 0.3125_r8                   ! canopy wetted fraction [0-1]
      real(r8), parameter :: h2o_liqvol_top = 0.0625_r8             ! liquid volumetric water, top soil layer [m3/m3]
      real(r8), parameter :: watsat_top = 0.5_r8                    ! porosity of top soil layer [m3/m3]
      real(r8), parameter :: expect_soil = 0.125_r8                 ! h2o_liqvol_top/watsat_top [0-1]
      real(r8), parameter :: expect_proxy = fwet_veg                ! the wetter ingredient [0-1]

      call this%patch%UpdateMossFwetLiq(fwet_veg, h2o_liqvol_top, watsat_top)

      @assertEqual(expect_soil, this%patch%fwet_moss_soil_liq, tolerance=tol)
      @assertEqual(fwet_veg, this%patch%fwet_moss_canopy_tot, tolerance=tol)
      @assertEqual(expect_proxy, this%patch%fwet_moss_liq, tolerance=tol)

    end subroutine UpdateMossFwetLiq_CanopyWetterThanSoil_ProxyTakesCanopy

    @Test
    subroutine UpdateMossFwetLiq_WaterAtPorosity_SoilSaturationIsOne(this)
      ! UpdateMossFwetLiq must report a fully saturated soil ingredient when the top soil
      ! layer holds liquid water exactly equal to its porosity.
      !
      ! The twin of UpdateMossFwetLiq_WaterAbovePorosity_SoilSaturationClampedToOne: same
      ! canopy wetted fraction, same soil water, differing only in the porosity, which
      ! there is small enough that the ratio overshoots. This case is at the limit
      ! already, so it cannot pin that the upper clamp is enforced -- it behaves the same
      ! whether that clamp is present, off by one, or absent -- and its twin is the one
      ! that catches a dropped clamp. What it does pin is that a layer at porosity reads
      ! as exactly full rather than merely close to it.
      !
      ! The soil ingredient and the proxy both read exactly one here and in the
      ! twin, so in these two cases alone a value written into the wrong member is caught
      ! only by the canopy assertion and by the setUp markers. Holding the soil water and
      ! the porosity equal, which is what puts this case at the limit, also makes it blind
      ! to a transposition of those two arguments; the twin, whose porosity is the smaller
      ! of its pair, is not. UpdateMossFwetTot_WaterAtPorosity_SoilSaturationIsOne is the
      ! same case for the total proxy.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_veg = 0.0625_r8                   ! canopy wetted fraction [0-1]
      real(r8), parameter :: h2o_liqvol_top = 0.375_r8              ! liquid volumetric water, top soil layer [m3/m3]
      real(r8), parameter :: watsat_top = 0.375_r8                  ! porosity of top soil layer [m3/m3]
      real(r8), parameter :: expect_soil = 1.0_r8                   ! h2o_liqvol_top/watsat_top [0-1]
      real(r8), parameter :: expect_proxy = expect_soil             ! the wetter ingredient [0-1]

      call this%patch%UpdateMossFwetLiq(fwet_veg, h2o_liqvol_top, watsat_top)

      @assertEqual(expect_soil, this%patch%fwet_moss_soil_liq, tolerance=tol)
      @assertEqual(fwet_veg, this%patch%fwet_moss_canopy_tot, tolerance=tol)
      @assertEqual(expect_proxy, this%patch%fwet_moss_liq, tolerance=tol)

    end subroutine UpdateMossFwetLiq_WaterAtPorosity_SoilSaturationIsOne

    @Test
    subroutine UpdateMossFwetLiq_WaterAbovePorosity_SoilSaturationClampedToOne(this)
      ! UpdateMossFwetLiq must clamp the soil ingredient to full saturation when the top
      ! soil layer holds more liquid water than its porosity allows.
      !
      ! The twin of UpdateMossFwetLiq_WaterAtPorosity_SoilSaturationIsOne: same canopy
      ! wetted fraction, same soil water, differing only in the porosity, which here is
      ! small enough that the ratio overshoots one. This is the case that has to grow into
      ! the limit, so it is the one that catches a dropped upper clamp; its twin, sitting at
      ! the limit already, cannot.
      !
      ! The soil ingredient and the proxy both read exactly one here and in the
      ! twin, so in these two cases alone a value written into the wrong member is caught
      ! only by the canopy assertion and by the setUp markers.
      ! UpdateMossFwetTot_WaterAbovePorosity_SoilSaturationClampedToOne is the same case
      ! for the total proxy.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_veg = 0.0625_r8                   ! canopy wetted fraction [0-1]
      real(r8), parameter :: h2o_liqvol_top = 0.375_r8              ! liquid volumetric water, top soil layer [m3/m3]
      real(r8), parameter :: watsat_top = 0.25_r8                   ! porosity of top soil layer [m3/m3]
      real(r8), parameter :: expect_soil = 1.0_r8                   ! the ratio overshoots and is clamped [0-1]
      real(r8), parameter :: expect_proxy = expect_soil             ! the wetter ingredient [0-1]

      call this%patch%UpdateMossFwetLiq(fwet_veg, h2o_liqvol_top, watsat_top)

      @assertEqual(expect_soil, this%patch%fwet_moss_soil_liq, tolerance=tol)
      @assertEqual(fwet_veg, this%patch%fwet_moss_canopy_tot, tolerance=tol)
      @assertEqual(expect_proxy, this%patch%fwet_moss_liq, tolerance=tol)

    end subroutine UpdateMossFwetLiq_WaterAbovePorosity_SoilSaturationClampedToOne

    @Test
    subroutine UpdateMossFwetLiq_NegativeSoilWater_SoilSaturationClampedToZero(this)
      ! UpdateMossFwetLiq must clamp the soil ingredient to zero when the top soil layer's
      ! liquid water content comes in negative.
      !
      ! The only liquid-proxy case in which the lower clamp binds, so the only one that
      ! catches its removal from this routine. The canopy ingredient (snow plus liquid) is
      ! the wetter of the two here, which keeps the proxy away from zero and so keeps a
      ! clamped-to-zero soil ingredient distinguishable from a proxy that has also
      ! collapsed.
      ! UpdateMossFwetTot_NegativeSoilWater_SoilSaturationClampedToZero is the same case
      ! for the total proxy.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_veg = 0.1875_r8                   ! canopy wetted fraction [0-1]
      real(r8), parameter :: h2o_liqvol_top = -0.125_r8             ! liquid volumetric water, top soil layer [m3/m3]
      real(r8), parameter :: watsat_top = 0.5_r8                    ! porosity of top soil layer [m3/m3]
      real(r8), parameter :: expect_soil = 0.0_r8                   ! the ratio undershoots and is clamped [0-1]
      real(r8), parameter :: expect_proxy = fwet_veg                ! the wetter ingredient [0-1]

      call this%patch%UpdateMossFwetLiq(fwet_veg, h2o_liqvol_top, watsat_top)

      @assertEqual(expect_soil, this%patch%fwet_moss_soil_liq, tolerance=tol)
      @assertEqual(fwet_veg, this%patch%fwet_moss_canopy_tot, tolerance=tol)
      @assertEqual(expect_proxy, this%patch%fwet_moss_liq, tolerance=tol)

    end subroutine UpdateMossFwetLiq_NegativeSoilWater_SoilSaturationClampedToZero

    @Test
    subroutine UpdateMossFwetLiq_SentinelPorosity_GuardZeroesSoil(this)
      ! UpdateMossFwetLiq must zero the soil ingredient when the host hands it the sentinel
      ! it writes for a column it has no soil data for.
      !
      ! The sentinel is carried in the soil water as well as in the porosity, which is
      ! what wrap_btran actually writes into both fields for a column outside the
      ! exposed-vegetation filter. That is load-bearing rather than decorative: with a
      ! valid positive soil water beside a sentinel porosity, deleting the porosity check
      ! in MossSoilSaturation (which zeroes the soil ingredient unless watsat_top >
      ! nearzero) yields a negative ratio that the lower clamp returns to zero, which is
      ! the answer the check gives, and the case would pass with the check gone. With the
      ! sentinel in both fields the ratio is exactly one instead, so a deleted or inverted
      ! check shows up.
      !
      ! The twin of UpdateMossFwetLiq_PorosityBelowNearzero_GuardZeroesSoil,
      ! which uses the same canopy wetted fraction and differs only in the porosity it
      ! rejects. UpdateMossFwetTot_SentinelPorosity_GuardZeroesSoil is the same
      ! case for the total proxy.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_veg = 0.4375_r8                   ! canopy wetted fraction [0-1]
      real(r8), parameter :: h2o_liqvol_top = watsat_sentinel       ! liquid volumetric water, top soil layer [m3/m3]
      real(r8), parameter :: watsat_top = watsat_sentinel           ! porosity of top soil layer [m3/m3]
      real(r8), parameter :: expect_soil = 0.0_r8                   ! the porosity check rejects it [0-1]
      real(r8), parameter :: expect_proxy = fwet_veg                ! the wetter ingredient [0-1]

      call this%patch%UpdateMossFwetLiq(fwet_veg, h2o_liqvol_top, watsat_top)

      @assertEqual(expect_soil, this%patch%fwet_moss_soil_liq, tolerance=tol)
      @assertEqual(fwet_veg, this%patch%fwet_moss_canopy_tot, tolerance=tol)
      @assertEqual(expect_proxy, this%patch%fwet_moss_liq, tolerance=tol)

    end subroutine UpdateMossFwetLiq_SentinelPorosity_GuardZeroesSoil

    @Test
    subroutine UpdateMossFwetLiq_PorosityBelowNearzero_GuardZeroesSoil(this)
      ! UpdateMossFwetLiq must zero the soil ingredient when the top soil layer's porosity
      ! is positive but negligibly small.
      !
      ! The twin of UpdateMossFwetLiq_SentinelPorosity_GuardZeroesSoil, which
      ! uses the same canopy wetted fraction and differs only in the porosity it rejects.
      ! This is the only liquid-proxy case that pins the threshold of the porosity check
      ! in MossSoilSaturation (watsat_top > nearzero) as strictly positive: a porosity of
      ! exactly the sentinel is rejected by a bare "greater than zero" test just as it is
      ! by the real one, whereas this porosity is not. The soil
      ! water is valid and large enough that dividing by this porosity overshoots the
      ! upper clamp, so a check that let it through would give a fully saturated soil
      ! ingredient rather than a dry one.
      !
      ! It bounds the threshold from below, and it does so tightly: its porosity is a
      ! quarter of nearzero rather than orders of magnitude under it.
      ! UpdateMossFwetLiq_PorosityAboveNearzero_GuardAdmitsSoil bounds it from
      ! above at twice nearzero, and the pair is worth far more than either half --
      ! together they hold the threshold inside a factor of eight, where a loose bracket
      ! would let it move by orders of magnitude with every test here still passing.
      ! UpdateMossFwetTot_PorosityBelowNearzero_GuardZeroesSoil is the same case
      ! for the total proxy.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_veg = 0.4375_r8                   ! canopy wetted fraction [0-1]
      real(r8), parameter :: h2o_liqvol_top = 0.75_r8               ! liquid volumetric water, top soil layer [m3/m3]
      real(r8), parameter :: watsat_top = watsat_below_nearzero     ! porosity of top soil layer [m3/m3]
      real(r8), parameter :: expect_soil = 0.0_r8                   ! the porosity check rejects it [0-1]
      real(r8), parameter :: expect_proxy = fwet_veg                ! the wetter ingredient [0-1]

      call this%patch%UpdateMossFwetLiq(fwet_veg, h2o_liqvol_top, watsat_top)

      @assertEqual(expect_soil, this%patch%fwet_moss_soil_liq, tolerance=tol)
      @assertEqual(fwet_veg, this%patch%fwet_moss_canopy_tot, tolerance=tol)
      @assertEqual(expect_proxy, this%patch%fwet_moss_liq, tolerance=tol)

    end subroutine UpdateMossFwetLiq_PorosityBelowNearzero_GuardZeroesSoil

    @Test
    subroutine UpdateMossFwetLiq_PorosityAboveNearzero_GuardAdmitsSoil(this)
      ! UpdateMossFwetLiq must admit a top soil layer whose porosity is small but still
      ! above the threshold below which the porosity check in MossSoilSaturation rejects it.
      !
      ! The twin of UpdateMossFwetLiq_PorosityBelowNearzero_GuardZeroesSoil: the
      ! two straddle the threshold of the porosity check in MossSoilSaturation at twice
      ! nearzero and a quarter of it, holding it inside a factor of eight.
      ! This is the only liquid-proxy case that has to grow into acceptance -- every other
      ! porosity the check must admit sits tens of orders of magnitude above the threshold
      ! -- so without it the threshold could be raised by thirty orders of magnitude and
      ! every other liquid-proxy test here would still pass.
      !
      ! The soil water and the porosity differ by an exact power of two, so their ratio is
      ! exact and neither clamp is involved in reaching it. The soil water is set relative
      ! to the porosity, so it follows nearzero along with it.
      ! UpdateMossFwetTot_PorosityAboveNearzero_GuardAdmitsSoil is the same case
      ! for the total proxy.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_veg = 0.0625_r8                   ! canopy wetted fraction [0-1]
      real(r8), parameter :: h2o_liqvol_top = 0.25_r8*watsat_above_nearzero ! liquid volumetric water, top soil layer [m3/m3]
      real(r8), parameter :: watsat_top = watsat_above_nearzero     ! porosity of top soil layer [m3/m3]
      real(r8), parameter :: expect_soil = 0.25_r8                  ! h2o_liqvol_top/watsat_top [0-1]
      real(r8), parameter :: expect_proxy = expect_soil             ! the wetter ingredient [0-1]

      call this%patch%UpdateMossFwetLiq(fwet_veg, h2o_liqvol_top, watsat_top)

      @assertEqual(expect_soil, this%patch%fwet_moss_soil_liq, tolerance=tol)
      @assertEqual(fwet_veg, this%patch%fwet_moss_canopy_tot, tolerance=tol)
      @assertEqual(expect_proxy, this%patch%fwet_moss_liq, tolerance=tol)

    end subroutine UpdateMossFwetLiq_PorosityAboveNearzero_GuardAdmitsSoil

    @Test
    subroutine UpdateMossFwetLiq_TotalProxySeeded_TotalUntouched(this)
      ! UpdateMossFwetLiq must leave the total proxy and its soil ingredient exactly as it
      ! found them.
      !
      ! setUp seeds all five members with distinct negative markers; after the call the
      ! total proxy and the total soil ingredient must still hold theirs. The inputs are an
      ! ordinary in-range case, chosen so that the liquid values the routine writes (soil
      ! 0.375, proxy 0.375, canopy_tot 0.125) are none of them a marker, so a routine that
      ! also wrote the liquid results into the total members, or zeroed them, is caught
      ! either way. The liquid members it does write are pinned by
      ! the UpdateMossFwetLiq carry-over cases above. The twin is
      ! UpdateMossFwetTot_LiquidProxySeeded_LiquidUntouched.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_veg = 0.125_r8                    ! canopy wetted fraction [0-1]
      real(r8), parameter :: h2o_liqvol_top = 0.1875_r8             ! liquid volumetric water, top soil layer [m3/m3]
      real(r8), parameter :: watsat_top = 0.5_r8                    ! porosity of top soil layer [m3/m3]

      call this%patch%UpdateMossFwetLiq(fwet_veg, h2o_liqvol_top, watsat_top)

      @assertEqual(marker_soil_tot, this%patch%fwet_moss_soil_tot, tolerance=tol)
      @assertEqual(marker_fwet_tot, this%patch%fwet_moss_tot, tolerance=tol)

    end subroutine UpdateMossFwetLiq_TotalProxySeeded_TotalUntouched

    ! ======================================================================================
    ! UpdateMossFwetTot: the total-water proxy and its two ingredients
    ! ======================================================================================

    @Test
    subroutine UpdateMossFwetTot_SoilWetterThanCanopy_ProxyTakesSoil(this)
      ! UpdateMossFwetTot must take the total proxy from the soil ingredient when the top
      ! soil layer is wetter than the canopy.
      !
      ! Uses the same numbers as UpdateMossFwetLiq_SoilWetterThanCanopy_ProxyTakesSoil,
      ! whose description says why these values, but asserts the total-proxy soil
      ! ingredient and proxy (fwet_moss_soil_tot, fwet_moss_tot) where that test asserts
      ! the liquid ones; both assert fwet_moss_canopy_tot; the two routines are
      ! required to compute their soil ingredient the same way. The twin within this
      ! routine is UpdateMossFwetTot_CanopyWetterThanSoil_ProxyTakesCanopy.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_veg = 0.125_r8                    ! canopy wetted fraction [0-1]
      real(r8), parameter :: h2o_totvol_top = 0.1875_r8             ! total volumetric water, top soil layer [m3/m3]
      real(r8), parameter :: watsat_top = 0.5_r8                    ! porosity of top soil layer [m3/m3]
      real(r8), parameter :: expect_soil = 0.375_r8                 ! h2o_totvol_top/watsat_top [0-1]
      real(r8), parameter :: expect_proxy = expect_soil             ! the wetter ingredient [0-1]

      call this%patch%UpdateMossFwetTot(fwet_veg, h2o_totvol_top, watsat_top)

      @assertEqual(expect_soil, this%patch%fwet_moss_soil_tot, tolerance=tol)
      @assertEqual(fwet_veg, this%patch%fwet_moss_canopy_tot, tolerance=tol)
      @assertEqual(expect_proxy, this%patch%fwet_moss_tot, tolerance=tol)

    end subroutine UpdateMossFwetTot_SoilWetterThanCanopy_ProxyTakesSoil

    @Test
    subroutine UpdateMossFwetTot_CanopyWetterThanSoil_ProxyTakesCanopy(this)
      ! UpdateMossFwetTot must take the total proxy from the canopy ingredient (snow plus
      ! liquid) when the canopy is wetter than the top soil layer.
      !
      ! Uses the same numbers as UpdateMossFwetLiq_CanopyWetterThanSoil_ProxyTakesCanopy,
      ! whose description says why these values, but asserts the total-proxy soil
      ! ingredient and proxy (fwet_moss_soil_tot, fwet_moss_tot) where that test asserts
      ! the liquid ones; both assert fwet_moss_canopy_tot. The twin within this
      ! routine is UpdateMossFwetTot_SoilWetterThanCanopy_ProxyTakesSoil.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_veg = 0.3125_r8                   ! canopy wetted fraction [0-1]
      real(r8), parameter :: h2o_totvol_top = 0.0625_r8             ! total volumetric water, top soil layer [m3/m3]
      real(r8), parameter :: watsat_top = 0.5_r8                    ! porosity of top soil layer [m3/m3]
      real(r8), parameter :: expect_soil = 0.125_r8                 ! h2o_totvol_top/watsat_top [0-1]
      real(r8), parameter :: expect_proxy = fwet_veg                ! the wetter ingredient [0-1]

      call this%patch%UpdateMossFwetTot(fwet_veg, h2o_totvol_top, watsat_top)

      @assertEqual(expect_soil, this%patch%fwet_moss_soil_tot, tolerance=tol)
      @assertEqual(fwet_veg, this%patch%fwet_moss_canopy_tot, tolerance=tol)
      @assertEqual(expect_proxy, this%patch%fwet_moss_tot, tolerance=tol)

    end subroutine UpdateMossFwetTot_CanopyWetterThanSoil_ProxyTakesCanopy

    @Test
    subroutine UpdateMossFwetTot_WaterAtPorosity_SoilSaturationIsOne(this)
      ! UpdateMossFwetTot must report a fully saturated soil ingredient when the top soil
      ! layer holds total water exactly equal to its porosity.
      !
      ! Uses the same numbers as UpdateMossFwetLiq_WaterAtPorosity_SoilSaturationIsOne,
      ! whose description says what a case already at the limit can and cannot pin, but
      ! asserts the total-proxy soil ingredient and proxy (fwet_moss_soil_tot,
      ! fwet_moss_tot) where that test asserts the liquid ones; both assert
      ! fwet_moss_canopy_tot. The twin within this routine, the one that catches a dropped
      ! upper clamp, is UpdateMossFwetTot_WaterAbovePorosity_SoilSaturationClampedToOne.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_veg = 0.0625_r8                   ! canopy wetted fraction [0-1]
      real(r8), parameter :: h2o_totvol_top = 0.375_r8              ! total volumetric water, top soil layer [m3/m3]
      real(r8), parameter :: watsat_top = 0.375_r8                  ! porosity of top soil layer [m3/m3]
      real(r8), parameter :: expect_soil = 1.0_r8                   ! h2o_totvol_top/watsat_top [0-1]
      real(r8), parameter :: expect_proxy = expect_soil             ! the wetter ingredient [0-1]

      call this%patch%UpdateMossFwetTot(fwet_veg, h2o_totvol_top, watsat_top)

      @assertEqual(expect_soil, this%patch%fwet_moss_soil_tot, tolerance=tol)
      @assertEqual(fwet_veg, this%patch%fwet_moss_canopy_tot, tolerance=tol)
      @assertEqual(expect_proxy, this%patch%fwet_moss_tot, tolerance=tol)

    end subroutine UpdateMossFwetTot_WaterAtPorosity_SoilSaturationIsOne

    @Test
    subroutine UpdateMossFwetTot_WaterAbovePorosity_SoilSaturationClampedToOne(this)
      ! UpdateMossFwetTot must clamp the soil ingredient to full saturation when the top
      ! soil layer holds more total water than its porosity allows.
      !
      ! Uses the same numbers as
      ! UpdateMossFwetLiq_WaterAbovePorosity_SoilSaturationClampedToOne, but asserts the
      ! total-proxy soil ingredient and proxy (fwet_moss_soil_tot, fwet_moss_tot) where
      ! that test asserts the liquid ones; both assert fwet_moss_canopy_tot.
      ! This is the total-proxy case that has to grow into the limit, so it is the one
      ! that catches a dropped upper clamp in this routine; its twin
      ! UpdateMossFwetTot_WaterAtPorosity_SoilSaturationIsOne cannot.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_veg = 0.0625_r8                   ! canopy wetted fraction [0-1]
      real(r8), parameter :: h2o_totvol_top = 0.375_r8              ! total volumetric water, top soil layer [m3/m3]
      real(r8), parameter :: watsat_top = 0.25_r8                   ! porosity of top soil layer [m3/m3]
      real(r8), parameter :: expect_soil = 1.0_r8                   ! the ratio overshoots and is clamped [0-1]
      real(r8), parameter :: expect_proxy = expect_soil             ! the wetter ingredient [0-1]

      call this%patch%UpdateMossFwetTot(fwet_veg, h2o_totvol_top, watsat_top)

      @assertEqual(expect_soil, this%patch%fwet_moss_soil_tot, tolerance=tol)
      @assertEqual(fwet_veg, this%patch%fwet_moss_canopy_tot, tolerance=tol)
      @assertEqual(expect_proxy, this%patch%fwet_moss_tot, tolerance=tol)

    end subroutine UpdateMossFwetTot_WaterAbovePorosity_SoilSaturationClampedToOne

    @Test
    subroutine UpdateMossFwetTot_NegativeSoilWater_SoilSaturationClampedToZero(this)
      ! UpdateMossFwetTot must clamp the soil ingredient to zero when the top soil layer's
      ! total water content comes in negative.
      !
      ! Uses the same numbers as
      ! UpdateMossFwetLiq_NegativeSoilWater_SoilSaturationClampedToZero, whose description
      ! says why the canopy ingredient is the wetter one here, but asserts the total-proxy
      ! soil ingredient and proxy (fwet_moss_soil_tot, fwet_moss_tot) where that test
      ! asserts the liquid ones; both assert fwet_moss_canopy_tot. The only
      ! total-proxy case in which the lower clamp binds.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_veg = 0.1875_r8                   ! canopy wetted fraction [0-1]
      real(r8), parameter :: h2o_totvol_top = -0.125_r8             ! total volumetric water, top soil layer [m3/m3]
      real(r8), parameter :: watsat_top = 0.5_r8                    ! porosity of top soil layer [m3/m3]
      real(r8), parameter :: expect_soil = 0.0_r8                   ! the ratio undershoots and is clamped [0-1]
      real(r8), parameter :: expect_proxy = fwet_veg                ! the wetter ingredient [0-1]

      call this%patch%UpdateMossFwetTot(fwet_veg, h2o_totvol_top, watsat_top)

      @assertEqual(expect_soil, this%patch%fwet_moss_soil_tot, tolerance=tol)
      @assertEqual(fwet_veg, this%patch%fwet_moss_canopy_tot, tolerance=tol)
      @assertEqual(expect_proxy, this%patch%fwet_moss_tot, tolerance=tol)

    end subroutine UpdateMossFwetTot_NegativeSoilWater_SoilSaturationClampedToZero

    @Test
    subroutine UpdateMossFwetTot_SentinelPorosity_GuardZeroesSoil(this)
      ! UpdateMossFwetTot must zero the soil ingredient when the host hands it the sentinel
      ! it writes for a column it has no soil data for.
      !
      ! Uses the same numbers as UpdateMossFwetLiq_SentinelPorosity_GuardZeroesSoil, whose
      ! description says why the sentinel has to be in the soil water as well as the
      ! porosity for a deleted porosity check to show, but asserts the total-proxy soil
      ! ingredient and proxy (fwet_moss_soil_tot, fwet_moss_tot) where that test asserts
      ! the liquid ones; both assert fwet_moss_canopy_tot. The twin within this
      ! routine is UpdateMossFwetTot_PorosityBelowNearzero_GuardZeroesSoil.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_veg = 0.4375_r8                   ! canopy wetted fraction [0-1]
      real(r8), parameter :: h2o_totvol_top = watsat_sentinel       ! total volumetric water, top soil layer [m3/m3]
      real(r8), parameter :: watsat_top = watsat_sentinel           ! porosity of top soil layer [m3/m3]
      real(r8), parameter :: expect_soil = 0.0_r8                   ! the porosity check rejects it [0-1]
      real(r8), parameter :: expect_proxy = fwet_veg                ! the wetter ingredient [0-1]

      call this%patch%UpdateMossFwetTot(fwet_veg, h2o_totvol_top, watsat_top)

      @assertEqual(expect_soil, this%patch%fwet_moss_soil_tot, tolerance=tol)
      @assertEqual(fwet_veg, this%patch%fwet_moss_canopy_tot, tolerance=tol)
      @assertEqual(expect_proxy, this%patch%fwet_moss_tot, tolerance=tol)

    end subroutine UpdateMossFwetTot_SentinelPorosity_GuardZeroesSoil

    @Test
    subroutine UpdateMossFwetTot_PorosityBelowNearzero_GuardZeroesSoil(this)
      ! UpdateMossFwetTot must zero the soil ingredient when the top soil layer's porosity
      ! is positive but negligibly small.
      !
      ! Uses the same numbers as UpdateMossFwetLiq_PorosityBelowNearzero_GuardZeroesSoil,
      ! whose description says how tightly this porosity bounds the threshold of the
      ! porosity check in MossSoilSaturation from below, but asserts the total-proxy soil
      ! ingredient and proxy (fwet_moss_soil_tot, fwet_moss_tot) where that test asserts
      ! the liquid ones; both assert fwet_moss_canopy_tot. It pairs with
      ! UpdateMossFwetTot_PorosityAboveNearzero_GuardAdmitsSoil, which bounds it from
      ! above, and with UpdateMossFwetTot_SentinelPorosity_GuardZeroesSoil, which differs
      ! only in the porosity it rejects.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_veg = 0.4375_r8                   ! canopy wetted fraction [0-1]
      real(r8), parameter :: h2o_totvol_top = 0.75_r8               ! total volumetric water, top soil layer [m3/m3]
      real(r8), parameter :: watsat_top = watsat_below_nearzero     ! porosity of top soil layer [m3/m3]
      real(r8), parameter :: expect_soil = 0.0_r8                   ! the porosity check rejects it [0-1]
      real(r8), parameter :: expect_proxy = fwet_veg                ! the wetter ingredient [0-1]

      call this%patch%UpdateMossFwetTot(fwet_veg, h2o_totvol_top, watsat_top)

      @assertEqual(expect_soil, this%patch%fwet_moss_soil_tot, tolerance=tol)
      @assertEqual(fwet_veg, this%patch%fwet_moss_canopy_tot, tolerance=tol)
      @assertEqual(expect_proxy, this%patch%fwet_moss_tot, tolerance=tol)

    end subroutine UpdateMossFwetTot_PorosityBelowNearzero_GuardZeroesSoil

    @Test
    subroutine UpdateMossFwetTot_PorosityAboveNearzero_GuardAdmitsSoil(this)
      ! UpdateMossFwetTot must admit a top soil layer whose porosity is small but still
      ! above the threshold below which the porosity check in MossSoilSaturation rejects it.
      !
      ! Uses the same numbers as UpdateMossFwetLiq_PorosityAboveNearzero_GuardAdmitsSoil,
      ! but asserts the total-proxy soil ingredient and proxy (fwet_moss_soil_tot,
      ! fwet_moss_tot) where that test asserts the liquid ones; both assert
      ! fwet_moss_canopy_tot. The only total-proxy case that has to grow into acceptance;
      ! with UpdateMossFwetTot_PorosityBelowNearzero_GuardZeroesSoil it holds this
      ! routine's threshold inside a factor of eight.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_veg = 0.0625_r8                   ! canopy wetted fraction [0-1]
      real(r8), parameter :: h2o_totvol_top = 0.25_r8*watsat_above_nearzero ! total volumetric water, top soil layer [m3/m3]
      real(r8), parameter :: watsat_top = watsat_above_nearzero     ! porosity of top soil layer [m3/m3]
      real(r8), parameter :: expect_soil = 0.25_r8                  ! h2o_totvol_top/watsat_top [0-1]
      real(r8), parameter :: expect_proxy = expect_soil             ! the wetter ingredient [0-1]

      call this%patch%UpdateMossFwetTot(fwet_veg, h2o_totvol_top, watsat_top)

      @assertEqual(expect_soil, this%patch%fwet_moss_soil_tot, tolerance=tol)
      @assertEqual(fwet_veg, this%patch%fwet_moss_canopy_tot, tolerance=tol)
      @assertEqual(expect_proxy, this%patch%fwet_moss_tot, tolerance=tol)

    end subroutine UpdateMossFwetTot_PorosityAboveNearzero_GuardAdmitsSoil

    @Test
    subroutine UpdateMossFwetTot_LiquidProxySeeded_LiquidUntouched(this)
      ! UpdateMossFwetTot must leave the liquid proxy and its soil ingredient exactly as
      ! it found them.
      !
      ! setUp seeds all five members with distinct negative markers; after the call the
      ! liquid proxy and the liquid soil ingredient must still hold theirs. The inputs
      ! match UpdateMossFwetLiq_TotalProxySeeded_TotalUntouched, the twin, so the two
      ! differ only in which routine is called and which members must survive it.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_veg = 0.125_r8                    ! canopy wetted fraction [0-1]
      real(r8), parameter :: h2o_totvol_top = 0.1875_r8             ! total volumetric water, top soil layer [m3/m3]
      real(r8), parameter :: watsat_top = 0.5_r8                    ! porosity of top soil layer [m3/m3]

      call this%patch%UpdateMossFwetTot(fwet_veg, h2o_totvol_top, watsat_top)

      @assertEqual(marker_soil_liq, this%patch%fwet_moss_soil_liq, tolerance=tol)
      @assertEqual(marker_fwet_liq, this%patch%fwet_moss_liq, tolerance=tol)

    end subroutine UpdateMossFwetTot_LiquidProxySeeded_LiquidUntouched

    ! ======================================================================================
    ! MossWetnessScaler: derived from the liquid proxy alone
    ! ======================================================================================

    @Test
    subroutine MossWetnessScaler_ProxyAtThreshold_ReachesFullCapacity(this)
      ! MossWetnessScaler must give moss its full photosynthetic capacity exactly at
      ! the liquid wetness at which it performs fully.
      !
      ! This case documents the design intent at the threshold, which the host namelist
      ! describes as the proxy at and above which moss performs fully. It does not pin
      ! that boundary as inclusive and cannot: the routine encodes no boundary, only a
      ! clamp on a ratio, which at a ratio of exactly one returns the same value whether
      ! the clamp is there or not. Its result is therefore necessarily the same as that of
      ! MossWetnessScaler_ProxyAboveThreshold_HeldAtFullCapacity. What separates the
      ! two is what reaches them: the sibling is the only one that catches a dropped
      ! clamp, while this case is caught by a threshold replaced with a literal, which
      ! also catches MossWetnessScaler_ProxyBelowThreshold_ScalesLinearly.
      !
      ! The three ingredients are asserted to still hold their setUp markers, which pins
      ! that evaluating the scaler leaves every other member as seeded. The proxies are
      ! not asserted here, and do not need to be: the liquid one is the quantity the
      ! scaler reads, and that UpdateMossFwetLiq writes it correctly is covered by the
      ! UpdateMossFwetLiq cases.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_moss_liq = test_vcmax_thresh_scaler ! liquid moss wetness proxy, at the threshold [0-1]
      real(r8), parameter :: expect_scaler = fwet_moss_liq/test_vcmax_thresh_scaler ! exactly one [0-1]

      hlm_moss_vcmax_fwet_thresh = test_vcmax_thresh_scaler
      this%patch%fwet_moss_liq = fwet_moss_liq

      @assertEqual(marker_soil_liq, this%patch%fwet_moss_soil_liq, tolerance=tol)
      @assertEqual(marker_soil_tot, this%patch%fwet_moss_soil_tot, tolerance=tol)
      @assertEqual(marker_canopy_tot, this%patch%fwet_moss_canopy_tot, tolerance=tol)
      @assertEqual(expect_scaler, this%patch%MossWetnessScaler(), tolerance=tol)

    end subroutine MossWetnessScaler_ProxyAtThreshold_ReachesFullCapacity

    @Test
    subroutine MossWetnessScaler_ProxyAboveThreshold_HeldAtFullCapacity(this)
      ! MossWetnessScaler must not carry moss past its full photosynthetic capacity
      ! when the liquid proxy is wetter than the wetness at which it performs fully.
      !
      ! The only one of the three threshold cases that has to grow into the clamp, so the
      ! only one that catches its removal; the sibling sitting exactly at the threshold
      ! reads the same result whether the clamp is there or not.
      !
      ! The three ingredients are asserted to still hold their setUp markers, which pins
      ! that evaluating the scaler leaves every other member as seeded. The proxies are
      ! not asserted here, and do not need to be: the liquid one is the quantity the
      ! scaler reads, and that UpdateMossFwetLiq writes it correctly is covered by the
      ! UpdateMossFwetLiq cases.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: above_multiple = 2.5_r8                ! how many thresholds wet the proxy is [-]
      real(r8), parameter :: fwet_moss_liq = above_multiple*test_vcmax_thresh_scaler ! liquid moss wetness proxy [0-1]
      real(r8), parameter :: expect_scaler = 1.0_r8                 ! full capacity: above_multiple overshoots and is clamped [0-1]

      hlm_moss_vcmax_fwet_thresh = test_vcmax_thresh_scaler
      this%patch%fwet_moss_liq = fwet_moss_liq

      @assertEqual(marker_soil_liq, this%patch%fwet_moss_soil_liq, tolerance=tol)
      @assertEqual(marker_soil_tot, this%patch%fwet_moss_soil_tot, tolerance=tol)
      @assertEqual(marker_canopy_tot, this%patch%fwet_moss_canopy_tot, tolerance=tol)
      @assertEqual(expect_scaler, this%patch%MossWetnessScaler(), tolerance=tol)

    end subroutine MossWetnessScaler_ProxyAboveThreshold_HeldAtFullCapacity

    @Test
    subroutine MossWetnessScaler_TotWetterThanLiq_FollowsLiquid(this)
      ! MossWetnessScaler must derive the scaler from the liquid proxy, not the
      ! total one, when the total proxy is the wetter of the two.
      !
      ! This is the configuration the model produces when part of the soil water is
      ! frozen. Both proxies hold plausible in-range values, below the threshold, and each
      ! gives a different scaler, so a scaler read from the wrong proxy lands on a value
      ! that is physically sensible and only this assertion distinguishes it. In the
      ! threshold cases the total proxy still holds its negative marker, which would also
      ! catch the wrong proxy, but only through a nonsensical negative scaler; this case
      ! pins the choice where both candidates look right. The twin is
      ! MossWetnessScaler_LiqWetterThanTot_FollowsLiquid, which swaps the two
      ! values. Same threshold as the threshold cases.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_moss_liq = 0.0625_r8              ! liquid moss wetness proxy [0-1]
      real(r8), parameter :: fwet_moss_tot = 0.1875_r8              ! total-water moss wetness proxy [0-1]
      real(r8), parameter :: expect_scaler = fwet_moss_liq/test_vcmax_thresh_scaler ! [0-1]

      hlm_moss_vcmax_fwet_thresh = test_vcmax_thresh_scaler
      this%patch%fwet_moss_liq = fwet_moss_liq
      this%patch%fwet_moss_tot = fwet_moss_tot

      @assertEqual(expect_scaler, this%patch%MossWetnessScaler(), tolerance=tol)

    end subroutine MossWetnessScaler_TotWetterThanLiq_FollowsLiquid

    @Test
    subroutine MossWetnessScaler_LiqWetterThanTot_FollowsLiquid(this)
      ! MossWetnessScaler must derive the scaler from the liquid proxy, not the
      ! total one, when the liquid proxy is the wetter of the two.
      !
      ! This configuration cannot occur in the model, because liquid water is a part of
      ! total water, so the liquid proxy never exceeds the total one. The test exists to
      ! pin which proxy the scaler reads: a routine that took the wetter or the drier of
      ! the two would pass the twin and fail here, or the reverse. The twin is
      ! MossWetnessScaler_TotWetterThanLiq_FollowsLiquid, which swaps the
      ! two values. Same threshold as the threshold cases.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_moss_liq = 0.1875_r8              ! liquid moss wetness proxy [0-1]
      real(r8), parameter :: fwet_moss_tot = 0.0625_r8              ! total-water moss wetness proxy [0-1]
      real(r8), parameter :: expect_scaler = fwet_moss_liq/test_vcmax_thresh_scaler ! [0-1]

      hlm_moss_vcmax_fwet_thresh = test_vcmax_thresh_scaler
      this%patch%fwet_moss_liq = fwet_moss_liq
      this%patch%fwet_moss_tot = fwet_moss_tot

      @assertEqual(expect_scaler, this%patch%MossWetnessScaler(), tolerance=tol)

    end subroutine MossWetnessScaler_LiqWetterThanTot_FollowsLiquid

    ! ======================================================================================
    ! MossCO2FilmFactor
    ! ======================================================================================

    @Test
    subroutine MossCO2FilmFactor_DryMoss_NoAttenuation(this)
      ! MossCO2FilmFactor must leave the boundary-layer conductance of bone-dry moss
      ! untouched.
      !
      ! The one input at which the factor is exactly one, so the only case that pins the
      ! dry end of the relation. The dry fraction is at its maximum here, which makes this
      ! case blind to almost everything else in the expression: the internal dry-fraction
      ! clamp does not bind, one raised to any power is one, and the outer floor loses to
      ! one at every setting the host permits. So it constrains neither clamp nor the
      ! exponent. The internal clamp is pinned by
      ! MossCO2FilmFactor_FloorBelowInnerClamp_InnerClampSets and the exponent by
      ! MossCO2FilmFactor_BelowOuterFloorCrossover_PowerLawSets instead.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_moss = 0.0_r8                     ! moss wetness proxy [0-1]
      real(r8), parameter :: expect_factor = 1.0_r8                 ! no attenuation of the boundary layer conductance [0-1]

      @assertEqual(expect_factor, MossCO2FilmFactor(fwet_moss), tolerance=tol)

    end subroutine MossCO2FilmFactor_DryMoss_NoAttenuation

    @Test
    subroutine MossCO2FilmFactor_BelowOuterFloorCrossover_PowerLawSets(this)
      ! MossCO2FilmFactor must return the power law of the dry fraction while that power
      ! law still lies above the floor the host sets.
      !
      ! The twin of MossCO2FilmFactor_AboveOuterFloorCrossover_OuterFloorSets: same host
      ! floor, differing only in the proxy, which there is wet enough that the power law
      ! has fallen through the floor. Between them they bracket the crossover and so pin
      ! which of the two terms is operative on each side of it.
      !
      ! The proxy is deliberately not one half, because the dry fraction and the proxy are
      ! equal there and a flip between them would go unnoticed. The expected value is
      ! given as a literal rather than recomputed from the exponent, so that a changed
      ! exponent has something to fail against; it is the twelfth power of 0.625 and is
      ! exact in binary.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_moss = 0.375_r8                   ! moss wetness proxy [0-1]
      real(r8), parameter :: expect_factor = 3.5527136788005009e-3_r8 ! 0.625**12, above the host floor [0-1]

      @assertEqual(expect_factor, MossCO2FilmFactor(fwet_moss), tolerance=tol)

    end subroutine MossCO2FilmFactor_BelowOuterFloorCrossover_PowerLawSets

    @Test
    subroutine MossCO2FilmFactor_AboveOuterFloorCrossover_OuterFloorSets(this)
      ! MossCO2FilmFactor must return the floor the host sets once the moss is wet enough
      ! that the power law of the dry fraction has fallen below it.
      !
      ! The twin of MossCO2FilmFactor_BelowOuterFloorCrossover_PowerLawSets: same host
      ! floor, differing only in the proxy, which here is wet enough to put the power law
      ! under it. The assertion is against the floor the test set rather than against a
      ! number, so a floor hardcoded in the source fails here. This is the regime the
      ! routine's header says the moss sits in from roughly two-thirds saturation upward
      ! at any floor the host permits.
      !
      ! Sitting on the floor makes this case blind to the exponent, but only by a step or
      ! two: the power law is 6.0e-8 here at the twelfth power, so it stays under the floor
      ! down to the ninth (3.8e-6, only just) and rises above it at the eighth (1.5e-5),
      ! where this case would go red. The exponent is pinned outright by
      ! MossCO2FilmFactor_BelowOuterFloorCrossover_PowerLawSets.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_moss = 0.75_r8                    ! moss wetness proxy [0-1]
      real(r8), parameter :: expect_factor = test_co2_film_min      ! the power law has fallen through the host floor [0-1]

      @assertEqual(expect_factor, MossCO2FilmFactor(fwet_moss), tolerance=tol)

    end subroutine MossCO2FilmFactor_AboveOuterFloorCrossover_OuterFloorSets

    @Test
    subroutine MossCO2FilmFactor_FloorBelowInnerClamp_InnerClampSets(this)
      ! MossCO2FilmFactor must override a host floor set below the bound its internal
      ! dry-fraction clamp imposes, in the wettest part of the range.
      !
      ! The routine's header states that the internal clamp has an effect in this regime
      ! and in no other, so this is the only case that can pin it; without it the clamp is
      ! dead code as far as this suite is concerned and its removal would pass everything.
      ! The host floor is therefore set well below what any host would really ask for --
      ! deliberately so, and it is reset by setUp before the next test, so it reaches
      ! nothing else. The proxy is wet enough that the raw dry fraction is under the
      ! clamp.
      !
      ! This case needs a tolerance of its own. tol would have caught an actual of zero
      ! here, but as an absolute bound it is only a relative bound of 0.1 against an
      ! expected value of 1.0e-12; tol_film_inner restores a relative bound comparable to
      ! the rest of the file. See its declaration for the two distances it sits between.
      class(TestMossFwet), intent(inout) :: this                    ! test object
      real(r8), parameter :: fwet_moss = 0.9375_r8                  ! moss wetness proxy [0-1]
      real(r8), parameter :: expect_factor = 1.0e-12_r8             ! the clamped dry fraction raised to the twelfth power [0-1]

      lb_params%moss_co2_film_min = test_co2_film_min_tiny

      @assertEqual(expect_factor, MossCO2FilmFactor(fwet_moss), tolerance=tol_film_inner)

    end subroutine MossCO2FilmFactor_FloorBelowInnerClamp_InnerClampSets

end module test_MossFwet
